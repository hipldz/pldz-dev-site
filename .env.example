# 本地文件的路径
ARTICLES_PATH=data/articles
IMAGES_PATH=data/images
RESOURCES_PATH=data/resources
CACHE_PATH=data/cache
WEBP_CACHE_PATH=data/cache/webp
DB_PATH=data/db
WWW_PATH=data/www

# 图片处理性能
IMAGE_PROCESS_CONCURRENCY=2
WEBP_METHOD=4

# GitHub CI 通知自动更新deployment
DEPLOY_NOTICE_TOKEN=change-me
DEPLOY_GITHUB_TOKEN=github_pat_xxx
DEPLOY_MAX_ARTIFACT_BYTES=104857600

# 自动化缓存上传和下载（X-Cache-Token 请求头）
CACHE_API_TOKEN=change-me

# 用户登录的JWT配置
SECRET_KEY=change-me
ACCESS_TOKEN_EXPIRE_MINUTES=3600
REFRESH_TOKEN_EXPIRE_DAYS=7
TWO_FACTOR_ISSUER=pldz-dev-site

# 管理员信息
